# ============================================================================
# WordPress core - not part of this project's source.
# The repository tracks only our own code: the custom theme and the custom
# plugin. WordPress core is provided by the environment.
# ============================================================================
/wp-admin/
/wp-includes/
/wp-*.php
/license.txt
/readme.html
/xmlrpc.php
/index.php
/.htaccess
/wp-config.php
/wp-config-sample.php
/wp-config-local.php
/wp-content/advanced-cache.php
/wp-content/db.php
/wp-content/object-cache.php
/wp-content/sunrise.php
/wp-content/maintenance.php

# ============================================================================
# wp-content - keep only our theme and our plugin.
# NOTE: a negated directory must be listed itself; git will not re-descend
# into an excluded directory to rescue files inside it.
# ============================================================================
/wp-content/plugins/*
!/wp-content/plugins/index.php
!/wp-content/plugins/programs-module/

/wp-content/themes/*
!/wp-content/themes/index.php
!/wp-content/themes/project/

# ============================================================================
# Runtime / user generated content
# ============================================================================
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/wflogs/
/wp-content/ai1wm-backups/

# ============================================================================
# Dependencies
# ============================================================================
node_modules/
vendor/

# ============================================================================
# Logs - never commit log files (also required by the test brief).
# build/ IS committed on purpose, see README.
# ============================================================================
*.log
error_log
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build/*.map
*.min.css.map
*.min.js.map

# ============================================================================
# Build / cache artefacts
# ============================================================================
.cache/
.sass-cache/
*.css.map
coverage/
.nyc_output/

# ============================================================================
# Environment & secrets
# ============================================================================
.env
.env.local
.env.*.local

# ============================================================================
# OS / editor noise
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ============================================================================
# Temporary files & database dumps
# ============================================================================
*.tmp
*.temp
*.bak
*.backup
*.sql
*.sql.gz
sql-dump-*.sql
